{
  "name": "shape.ai",
  "version": "0.1.0",
  "description": "An infinite scene workspace that agents can review and extend through MCP.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/index.ts",
    "mcp": "tsx src/server/mcp.ts",
    "start": "npm run build && tsx src/server/index.ts --open",
    "typecheck": "tsc --noEmit",
    "build": "npm run renderer:wasm:build && vite build && tsc -p tsconfig.server.json",
    "build:svelte": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "renderer:test": "vitest run tests/infinite-canvas-renderer.test.ts",
    "renderer:rust:test": "scripts/renderer-toolchain.sh cargo test --manifest-path src/renderer/core/Cargo.toml --features wgpu-probe",
    "renderer:wasm:build": "scripts/renderer-toolchain.sh wasm-pack build src/renderer/core --target web --out-dir ../../client/renderer/wasm --out-name shape_canvas_core"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.8.5",
    "sql.js": "^1.14.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.10.2",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^9.2.1",
    "lucide-svelte": "^0.556.0",
    "svelte": "^5.56.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
